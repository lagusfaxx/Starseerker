# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# En Coolify con docker-compose.yaml este valor lo arma el propio compose
# apuntando al servicio `postgres`; aquí solo hace falta para desarrollo local.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:clave@localhost:5432/starseerker?schema=public"

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
# Dominio público. Se lee en tiempo de ejecución (correos, Mercado Pago,
# sitemap) y también se pasa como build arg para las URLs canónicas.
APP_URL="https://starseerker.cl"

# Secreto para firmar la sesión del panel (mínimo 24 caracteres).
# Genera uno con: openssl rand -base64 48
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Mercado Pago (cuenta de Chile)
# https://www.mercadopago.cl/developers/panel
# ---------------------------------------------------------------------------
MP_ACCESS_TOKEN=""
# Clave secreta del webhook, se copia desde el panel de notificaciones de MP.
MP_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Resend (correos transaccionales)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM="STARSEEKER Chile <hola@starseerker.cl>"
# Destinatarios de los avisos de venta (separados por coma).
ORDER_NOTIFICATION_EMAIL="ventas@starseerker.cl"

# ---------------------------------------------------------------------------
# Usuario inicial del panel
# Lo crea el seed: en Docker se ejecuta solo en el primer arranque.
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@starseerker.cl"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# auto  = sembrar solo la primera vez (por defecto)
# true  = sembrar en cada arranque (todo es upsert, no duplica)
# false = no sembrar nunca
RUN_SEED="auto"

# El seed NO crea productos. Ponlo en true si quieres partir con el esqueleto
# del catálogo oficial de STARSEEKER (nombre, SKU y categoría) como borradores
# sin precio ni publicar.
SEED_CATALOG="false"
