# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:clave@localhost:5432/starseerker?schema=public"

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://starseerker.cl"

# Secreto para firmar la sesión del panel (mínimo 24 caracteres).
# Genera uno con: openssl rand -base64 48
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Mercado Pago (cuenta de Chile)
# https://www.mercadopago.cl/developers/panel
# ---------------------------------------------------------------------------
MP_ACCESS_TOKEN=""
# Clave secreta del webhook, se copia desde el panel de notificaciones de MP.
MP_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Resend (correos transaccionales)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM="STARSEEKER Chile <hola@starseerker.cl>"
# Destinatarios de los avisos de venta (separados por coma).
ORDER_NOTIFICATION_EMAIL="ventas@starseerker.cl"

# ---------------------------------------------------------------------------
# Usuario inicial del panel (solo para `npm run db:seed`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@starseerker.cl"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
